{
  "name": "layout-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Brand-aware document layout studio (Markdown → PDF, more formats planned).",
  "scripts": {
    "dev": "pnpm --filter @layout-studio/web dev",
    "build:wheel": "bash scripts/build-wheel.sh",
    "build": "pnpm build:wheel && pnpm --filter @layout-studio/web build"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
